{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window. The print window has its own capability.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "serialplugin:default",
    "mcp-bridge:default",
    "dialog:default",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "updater:default",
    "process:default",
    "os:default",
    "window-state:default"
  ]
}
