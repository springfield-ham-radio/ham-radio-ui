{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ham Radio",
  "version": "../package.json",
  "identifier": "com.springfield.ham-radio",
  "build": {
    "frontendDist": "../.output/public",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn generate"
  },
  "app": {
    "windows": [
      {
        "title": "Ham Radio",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:ham-radio.db"]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0QzEyOTBGNjcyRDY5M0YKUldRL2FTMW5EeW5CMUIxbXh6Rk82Q28rYkNVWStGWFQ1TXlCdEkyZnd2UWtvbGFDRXdIUkZER3cK",
      "endpoints": [
        "https://github.com/springfield-ham-radio/ham-radio-ui/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
