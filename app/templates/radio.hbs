<YetiTable @data={{this.model.channels}} as |table|>
    <table.header as |header|>
      <header.column @prop="channelNumber">
        Number
      </header.column>
      <header.column @prop="radioChannel.channelName">
        Name
      </header.column>
      <header.column @prop="transmitPower">
        Power
      </header.column>
      <header.column @prop="radioChannel.transmitFrequency">
        Transmit
      </header.column>
      <header.column @prop="radioChannel.transmitTone">
        Tone
      </header.column>
      <header.column @prop="radioChannel.receiveFrequency">
        Receive
      </header.column>
      <header.column @prop="radioChannel.receiveTone">
        Tone
      </header.column>
    </table.header>

    <table.body/>
  </YetiTable>
