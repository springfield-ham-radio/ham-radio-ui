{
  "name": "@springfield/ham-radio-ui",
  "productName": "HamBench",
  "version": "3.24.0",
  "private": true,
  "type": "module",
  "description": "HamBench amateur radio management application",
  "author": {
    "name": "Bryan Hunt",
    "email": "bhunt@nvidia.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/springfield-ham-radio/ham-radio-ui.git"
  },
  "scripts": {
    "build": "nuxt build",
    "prepare": "yarn build",
    "bundle:sniffer": "node scripts/bundle-sniffer-resources.ts",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "typecheck": "nuxt prepare && vitest --typecheck run test/unit",
    "test": "yarn test:unit",
    "test:unit": "vitest --typecheck run test/unit",
    "tauri": "tauri",
    "pretauri:dev": "yarn bundle:sniffer",
    "tauri:dev": "tauri dev",
    "pretauri:build": "yarn bundle:sniffer",
    "tauri:build": "tauri build",
    "release": "semantic-release"
  },
  "dependencies": {
    "@nuxt/ui": "4.13.0",
    "@springfield/ham-radio-api": "18.5.0",
    "@springfield/ham-radio-driver": "^3.8.0",
    "@springfield/ham-radio-registry": "2.2.0",
    "@springfield/ham-radio-utils": "^4.19.0",
    "@tanstack/vue-virtual": "^3.13.52",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-os": "^2.2.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-sql": "^2.6.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "buffer": "^6.0.3",
    "eventemitter3": "^5.0.4",
    "fflate": "^0.8.2",
    "katex": "^0.19.1",
    "loglayer": "^9.4.0",
    "maplibre-gl": "^6.19.0",
    "nuxt": "^4.6.4",
    "sortablejs": "^1.15.7",
    "tauri-plugin-serialplugin-api": "4.2.2",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.157",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.11",
    "@semantic-release/npm": "13.2.0",
    "@springfield/radio-module-baofeng": "^3.1.0",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "26.6.6",
    "@types/sortablejs": "^1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "happy-dom": "^21.0.4",
    "oxlint": "1.94.0",
    "semantic-release": "26.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "7.0.2",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  },
  "resolutions": {
    "@springfield/ham-radio-api": "18.5.0",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "esbuild@npm:^0.27.0": "0.28.2",
    "glob": "14.0.3",
    "minimatch": "11.0.3",
    "vite": "^8.2.4"
  },
  "release": {
    "branches": [
      "main",
      {
        "name": "beta",
        "prerelease": true
      }
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "node scripts/set-cargo-version.mjs ${nextRelease.version}",
          "successCmd": "echo \"v${nextRelease.version}\" > .released-tag"
        }
      ],
      "@semantic-release/github",
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json",
            "src-tauri/Cargo.toml",
            "src-tauri/Cargo.lock"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ]
    ]
  },
  "packageManager": "yarn@4.18.0"
}
